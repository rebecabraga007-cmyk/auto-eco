# Copie para .env e preencha, ou defina como variaveis de ambiente antes de rodar.

# Bright Data LinkedIn Scraper API (recomendado). Sem isso, cai no fallback do Google.
BRIGHTDATA_API_KEY=

# --- Dataset (Marketplace) — roster COMPLETO por empresa. DESLIGADO no MVP free. ---
# Ligue (1) apenas depois de comprar o dataset "LinkedIn people profiles" (min $250).
BRIGHTDATA_USE_DATASET=0
# ID do dataset de Marketplace (confirme no painel: Datasets > LinkedIn people profiles > API).
BRIGHTDATA_PEOPLE_DATASET_ID=gd_l1viktl72bvl7bjuj0
# Teto de registros por empresa (controla custo — cada registro e cobrado).
BRIGHTDATA_DATASET_LIMIT=200

# (Opcional) Cookie de sessao do LinkedIn, usado apenas pelo fallback do Google.
LINKEDIN_LI_AT=

# --- Mk Buscas / WorkAPI (consulta por CPF: telefone, endereco, empregos) ---
# Basta a chave; base/rota/header ja tem default para a WorkAPI.
WORKAPI_KEY=
# (Opcional) sobrescrever defaults da WorkAPI:
# MK_BASE_URL=https://api.workapi.dev/v1/gateway
# MK_CPF_PATH=/work-cpf?cpf={cpf}
# MK_AUTH_HEADER=x-api-key
# MK_METHOD=GET

# --- Serasa Experian Infomais 2.0 (telefone/email por CPF/CNPJ) ---
# Sem isso, os endpoints /contacts respondem "unavailable".
SERASA_CLIENT_ID=
SERASA_CLIENT_SECRET=
SERASA_ENV=prod
# (Opcional) Se o contrato usa pacote:
SERASA_PACKAGE_TOKEN=

# --- Infosimples (Antecedentes Criminais / Policia Federal / Emitir) ---
# Usado na aba DOSSIE para anexar a certidao/JSON de antecedentes no PDF de CPF.
INFOSIMPLES_TOKEN=
# INFOSIMPLES_BASE_URL=https://api.infosimples.com

# --- FDX APIs (vinculos empregaticios por CNPJ, base RAIS) ---
# Sem isso, a aba "Quem trabalha aqui" responde "unavailable".
FDX_TOKEN=
# FDX_BASE_URL=https://api.fdxapis.us/api.php

# --- Mistral AI (insight + web search do dossie CPF) ---
# insight=true na rota /api/dossie/pdf usa a Mistral.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# Web search usa a Conversations API da Mistral e a ferramenta built-in web_search.
MISTRAL_WEB_SEARCH_ENABLED=1
# Troque para web_search_premium se a conta/plano liberar a ferramenta premium.
MISTRAL_WEB_SEARCH_TOOL=web_search
# Opcional: caminho alternativo para instrucoes do agente.
# MISTRAL_AGENT_MD=agente.md
