[Unit]
Description=CapiBLU - baixa o snapshot mensal da assinatura (Bright Data)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/capiblu/lupa-empresas/backend
EnvironmentFile=/opt/capiblu/lupa-empresas/.env
Environment=CNPJ_DB_DIR=/capiblu_data
Environment=PULL_DIR=/capiblu_data/pulls
# So perfis deste pais entram no cache (o snapshot vem do mundo inteiro).
Environment=PULL_PAIS=BR
ExecStart=/opt/capiblu/venv/bin/python pull_mensal.py
# Baixar 700 MB e semear 100 mil linhas leva minutos, nao horas: nao ha job
# assincrono pra esperar. Uma hora e folga suficiente.
TimeoutStartSec=1h
StandardOutput=append:/var/log/capiblu-pull-mensal.log
StandardError=append:/var/log/capiblu-pull-mensal.log
